#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
VERSION_FILE="$REPO_ROOT/VERSION"
PACKAGE_ID="io.github.badwordsno.minimalistblack"
PACKAGE_ROOT="$REPO_ROOT/packages/store/$PACKAGE_ID"
PAYLOAD_DENYLIST="$REPO_ROOT/release/nonredistributable-payloads.sha256"
OUTPUT_DIR="$REPO_ROOT/dist/store"
SOURCE_DATE_EPOCH_VALUE=${SOURCE_DATE_EPOCH:-315532800}

usage() {
    cat <<'EOF'
Usage: scripts/build-store-release [OPTIONS]

Validate and build the deterministic KDE Store Plasma 6 package archive.

Options:
  --output PATH      Destination directory (default: dist/store)
  --output-dir PATH  Alias for --output
  -h, --help         Show this help

The archive is appearance-only. It never contains a desktop layout, wallpaper,
Applet, script, private asset, or user-specific configuration.
EOF
}

while (($#)); do
    case "$1" in
        --output | --output-dir)
            (($# >= 2)) || {
                printf 'error: %s requires a path\n' "$1" >&2
                exit 2
            }
            OUTPUT_DIR=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            printf 'error: unknown argument: %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

for command_name in awk cp find grep install jq mktemp realpath sha256sum sort touch zip; do
    command -v -- "$command_name" >/dev/null 2>&1 || {
        printf 'error: required release tool is unavailable: %s\n' "$command_name" >&2
        exit 1
    }
done

[[ -f $VERSION_FILE && ! -L $VERSION_FILE ]] || {
    printf 'error: VERSION is missing or unsafe\n' >&2
    exit 1
}
[[ -d $PACKAGE_ROOT && ! -L $PACKAGE_ROOT ]] || {
    printf 'error: Store package root is missing or unsafe: %s\n' "$PACKAGE_ROOT" >&2
    exit 1
}
[[ -f $PAYLOAD_DENYLIST && ! -L $PAYLOAD_DENYLIST ]] || {
    printf 'error: non-redistributable payload denylist is missing or unsafe\n' >&2
    exit 1
}

version=$(< "$VERSION_FILE")
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    printf 'error: VERSION must be a semantic x.y.z value: %s\n' "$version" >&2
    exit 1
}
[[ $SOURCE_DATE_EPOCH_VALUE =~ ^[0-9]+$ && $SOURCE_DATE_EPOCH_VALUE -ge 315532800 ]] || {
    printf 'error: SOURCE_DATE_EPOCH must be an integer on or after 1980-01-01\n' >&2
    exit 1
}

metadata="$PACKAGE_ROOT/metadata.json"
manifest="$PACKAGE_ROOT/manifest.json"
[[ -f $metadata && ! -L $metadata && -f $manifest && ! -L $manifest ]] || {
    printf 'error: Store metadata.json or manifest.json is missing or unsafe\n' >&2
    exit 1
}

jq -e --arg id "$PACKAGE_ID" --arg version "$version" '
    .KPackageStructure == "Plasma/LookAndFeel"
    and .KPlugin.Id == $id
    and .KPlugin.Version == $version
    and .KPlugin.License == "MIT"
    and (.KPlugin.BugReportUrl | startswith("https://github.com/"))
    and .["X-Plasma-API-Minimum-Version"] == "6.0"
' "$metadata" >/dev/null || {
    printf 'error: metadata.json does not match the Store package contract\n' >&2
    exit 1
}

jq -e --arg id "$PACKAGE_ID" --arg version "$version" '
    .schemaVersion == 1
    and .package.id == $id
    and .package.version == $version
    and .package.structure == "Plasma/LookAndFeel"
    and .scope.mode == "appearance-only"
    and .compatibility.plasmaMajor == 6
    and .compatibility.breezeRequired == true
    and .assets.previewOrigin == "generated"
    and .assets.privateAssetsIncluded == false
    and (.scope.excluded | sort) == ([
        "applets", "cursors", "desktop-layout", "fonts", "icons",
        "scripts", "splash", "wallpaper"
    ] | sort)
' "$manifest" >/dev/null || {
    printf 'error: manifest.json does not match the appearance-only contract\n' >&2
    exit 1
}

expected_files=$(printf '%s\n' \
    'LICENSE' \
    'contents/colors' \
    'contents/defaults' \
    'contents/previews/fullscreenpreview.jpg' \
    'contents/previews/preview.png' \
    'manifest.json' \
    'metadata.json')
actual_files=$(find "$PACKAGE_ROOT" -mindepth 1 -type f -printf '%P\n' | LC_ALL=C sort)
[[ $actual_files == "$expected_files" ]] || {
    printf 'error: Store package file allowlist mismatch\n' >&2
    printf 'expected:\n%s\nactual:\n%s\n' "$expected_files" "$actual_files" >&2
    exit 1
}
expected_directories=$(printf '%s\n' 'contents' 'contents/previews')
actual_directories=$(find "$PACKAGE_ROOT" -mindepth 1 -type d -printf '%P\n' | LC_ALL=C sort)
[[ $actual_directories == "$expected_directories" ]] || {
    printf 'error: Store package directory allowlist mismatch\n' >&2
    printf 'expected:\n%s\nactual:\n%s\n' "$expected_directories" "$actual_directories" >&2
    exit 1
}

if find "$PACKAGE_ROOT" -mindepth 1 -type l -print -quit | grep -q .; then
    printf 'error: Store package contains a symbolic link\n' >&2
    exit 1
fi
if find "$PACKAGE_ROOT" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
    printf 'error: Store package contains an unsupported filesystem object\n' >&2
    exit 1
fi
forbidden_content_pattern='Minimalist''V02|PRIVATE-''ASSET|Propriet''ary|assets/wall''papers|/ho''me/|/Us''ers/|[A-Za-z]:\\Us''ers\\|BEGIN (RSA |OPENSSH |EC )?PRIVATE ''KEY|kwinoutputconfig|\.local/share/kscreen'
if grep -aEq "$forbidden_content_pattern" \
    "$metadata" "$manifest" "$PACKAGE_ROOT/contents/defaults" "$PACKAGE_ROOT/contents/colors" \
    "$PACKAGE_ROOT/contents/previews/preview.png" \
    "$PACKAGE_ROOT/contents/previews/fullscreenpreview.jpg"; then
    printf 'error: Store package contains a private, user-specific, or display-state marker\n' >&2
    exit 1
fi
declare -A forbidden_hash=()
while IFS= read -r digest rest || [[ -n ${digest:-} ]]; do
    case "${digest:-}" in
        '' | \#*) continue ;;
    esac
    [[ $digest =~ ^[0-9a-f]{64}$ ]] || {
        printf 'error: malformed non-redistributable payload denylist\n' >&2
        exit 1
    }
    forbidden_hash[$digest]=1
done < "$PAYLOAD_DENYLIST"
while IFS= read -r -d '' package_file; do
    package_hash=$(sha256sum -- "$package_file")
    package_hash=${package_hash%% *}
    [[ -z ${forbidden_hash[$package_hash]+x} ]] || {
        printf 'error: Store package contains an excluded archival payload\n' >&2
        exit 1
    }
done < <(find "$PACKAGE_ROOT" -type f -print0)
if grep -Eq '^\[Wallpaper\]|LookAndFeelPackage|ShellPackage' "$PACKAGE_ROOT/contents/defaults"; then
    printf 'error: Store defaults exceed the appearance-only contract\n' >&2
    exit 1
fi
if ! grep -Fqx 'ColorScheme=KdeRiceStoreBlack' "$PACKAGE_ROOT/contents/defaults" \
    || ! grep -Fqx 'ColorScheme=KdeRiceStoreBlack' "$PACKAGE_ROOT/contents/colors"; then
    printf 'error: Store palette identity is missing or inconsistent\n' >&2
    exit 1
fi

for preview in \
    "$PACKAGE_ROOT/contents/previews/preview.png" \
    "$PACKAGE_ROOT/contents/previews/fullscreenpreview.jpg"; do
    [[ -s $preview && ! -L $preview ]] || {
        printf 'error: Store preview is missing or unsafe: %s\n' "$preview" >&2
        exit 1
    }
done
expected_preview_hashes=$(jq -r '.assets.previews | [.fullscreen.sha256, .tile.sha256] | .[]' "$manifest")
actual_preview_hashes=$(sha256sum \
    "$PACKAGE_ROOT/contents/previews/fullscreenpreview.jpg" \
    "$PACKAGE_ROOT/contents/previews/preview.png" \
    | awk '{print $1}')
[[ $actual_preview_hashes == "$expected_preview_hashes" ]] || {
    printf 'error: committed Store preview hashes differ from manifest.json\n' >&2
    exit 1
}

if [[ $OUTPUT_DIR != /* ]]; then
    OUTPUT_DIR="$PWD/$OUTPUT_DIR"
fi
[[ ! -L $OUTPUT_DIR ]] || {
    printf 'error: refusing a symbolic-link output directory: %s\n' "$OUTPUT_DIR" >&2
    exit 1
}
OUTPUT_DIR=$(realpath -m -- "$OUTPUT_DIR")
[[ $OUTPUT_DIR != / ]] || {
    printf 'error: unsafe output directory: %s\n' "$OUTPUT_DIR" >&2
    exit 1
}
mkdir -p -- "$OUTPUT_DIR"
[[ -d $OUTPUT_DIR && -w $OUTPUT_DIR ]] || {
    printf 'error: output directory is unavailable: %s\n' "$OUTPUT_DIR" >&2
    exit 1
}

work_root=$(mktemp -d /tmp/kde-rice-store-release.XXXXXX)
cleanup() {
    case "$work_root" in
        /tmp/kde-rice-store-release.*) rm -rf -- "$work_root" ;;
    esac
}
trap cleanup EXIT

stage_root="$work_root/package"
mkdir -p -- "$stage_root"
while IFS= read -r relative; do
    install -D -m 0644 -- "$PACKAGE_ROOT/$relative" "$stage_root/$relative"
done <<< "$expected_files"

while IFS= read -r staged_path; do
    touch -h -d "@$SOURCE_DATE_EPOCH_VALUE" -- "$staged_path"
done < <(find "$stage_root" -mindepth 1 -print | LC_ALL=C sort)

archive_name="minimalist-black-plasma6-$version.zip"
archive_temp="$work_root/$archive_name"
(
    cd -- "$stage_root"
    find . -type f -printf '%P\n' | LC_ALL=C sort \
        | TZ=UTC zip -X -q "$archive_temp" -@
)

archive_path="$OUTPUT_DIR/$archive_name"
[[ ! -L $archive_path ]] || {
    printf 'error: refusing a symbolic-link release target: %s\n' "$archive_path" >&2
    exit 1
}
[[ ! -e $archive_path || -f $archive_path ]] || {
    printf 'error: release target is not a regular file: %s\n' "$archive_path" >&2
    exit 1
}
install -m 0644 -- "$archive_temp" "$archive_path"
archive_hash=$(sha256sum -- "$archive_path")

printf 'Store release archive: %s\n' "$archive_path"
printf 'SHA-256: %s\n' "${archive_hash%% *}"
