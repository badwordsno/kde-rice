#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
OUTPUT_DIR=$REPO_ROOT/dist
SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-0}

usage() {
    cat <<'EOF'
Usage: scripts/build-release [OPTIONS]

Build the versioned public source archive and SHA256SUMS.

Options:
  --output PATH  Output directory (default: ./dist)
  -h, --help     Show this help
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --output | --output-dir)
            (($# >= 2)) || die "$1 requires a path"
            OUTPUT_DIR=$2
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

[[ $SOURCE_DATE_EPOCH =~ ^[0-9]+$ ]] \
    || die "SOURCE_DATE_EPOCH must be a non-negative integer"
for builder in "$SCRIPT_DIR/build-source-release"; do
    [[ -x $builder && ! -L $builder ]] || die "release builder is unavailable: $builder"
done
for command_name in realpath mkdir mktemp install sha256sum sort xargs; do
    command -v "$command_name" >/dev/null 2>&1 \
        || die "required release tool is unavailable: $command_name"
done

if [[ $OUTPUT_DIR != /* ]]; then
    OUTPUT_DIR="$PWD/$OUTPUT_DIR"
fi
[[ ! -L $OUTPUT_DIR ]] || die "refusing a symlinked output directory"
OUTPUT_DIR=$(realpath -m -- "$OUTPUT_DIR") || die "output path could not be normalized"
[[ $OUTPUT_DIR != / ]] || die "unsafe output directory"
mkdir -p -- "$OUTPUT_DIR"
OUTPUT_DIR=$(realpath -e -- "$OUTPUT_DIR") || die "output directory could not be resolved"
[[ ! -L $OUTPUT_DIR/SHA256SUMS ]] || die "refusing to replace a symlinked SHA256SUMS"

SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH \
    "$SCRIPT_DIR/build-source-release" --output "$OUTPUT_DIR"

version=$(< "$REPO_ROOT/VERSION")
artifacts=(
    "minimalist-black-kde-$version.tar.xz"
)
for artifact in "${artifacts[@]}"; do
    [[ -f $OUTPUT_DIR/$artifact && ! -L $OUTPUT_DIR/$artifact ]] \
        || die "expected release artifact is missing or unsafe: $artifact"
done

checksum_temp=$(mktemp /tmp/kde-rice-sha256sums.XXXXXX)
cleanup() {
    case "$checksum_temp" in
        /tmp/kde-rice-sha256sums.*) rm -f -- "$checksum_temp" ;;
    esac
}
trap cleanup EXIT
(
    cd -- "$OUTPUT_DIR"
    printf '%s\n' "${artifacts[@]}" | LC_ALL=C sort | xargs sha256sum --
) > "$checksum_temp"
install -m 0644 -- "$checksum_temp" "$OUTPUT_DIR/SHA256SUMS"

printf 'Release artifacts and checksums: %s\n' "$OUTPUT_DIR"
