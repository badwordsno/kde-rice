#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

MANIFEST="$REPO_ROOT/config/managed-paths.txt"
TARGET_HOME=${HOME:-}
APPLY=false
ALLOW_DEGRADED=false
DOCTOR_COMMAND=${KDE_RICE_DOCTOR_COMMAND:-$SCRIPT_DIR/doctor}
LAYOUT_SOURCE_RELATIVE="layouts/plasma/org.kde.minimalist-v03"
LAYOUT_TARGET_RELATIVE=".local/share/plasma/layout-templates/org.kde.minimalist-v03"
RESOURCE_SOURCE_RELATIVE="plasmoids/org.kde.minimalist.resources"
RESOURCE_TARGET_RELATIVE=".local/share/plasma/plasmoids/org.kde.minimalist.resources"

usage() {
    cat <<'EOF'
Usage: scripts/apply-minimalist-v03 [OPTIONS]

Preview or apply the additive Minimalist v0.3 resource strip. Preview is the
default. The only panel-topology change is one project-owned text Plasmoid,
placed after the flexible spacer and before the existing status controls.

Options:
  --home ABSOLUTE_PATH  Target home directory (default: $HOME)
  --apply               Snapshot, install, and activate the resource strip
  --dry-run             Explicitly select preview mode (default)
  --allow-degraded      Permit an explicitly reviewed degraded apply
  -h, --help            Show this help

Accepted live states are the exact Minimalist v0.2 target and this script's
exact v0.3 target. Every other topology is refused before snapshot or mutation.
EOF
}

while (($#)); do
    case "$1" in
        --home)
            (($# >= 2)) || die "--home requires a path"
            TARGET_HOME=$2
            shift 2
            ;;
        --apply)
            APPLY=true
            shift
            ;;
        --dry-run)
            APPLY=false
            shift
            ;;
        --allow-degraded)
            ALLOW_DEGRADED=true
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

require_command realpath
require_command cp
require_command date
require_command mv
refuse_root

TARGET_HOME=$(normalize_existing_directory "$TARGET_HOME" "target home")
if [[ -v KDE_RICE_DOCTOR_COMMAND || -v KDE_RICE_DBUS_TOOL ]]; then
    [[ ${KDE_RICE_TEST_MODE:-0} == 1 ]] \
        || die "internal v0.3 overrides are available only in isolated test mode"
fi
require_current_desktop_home "$TARGET_HOME" dbus-mock
[[ -x $DOCTOR_COMMAND ]] || die "doctor command is unavailable: $DOCTOR_COMMAND"

set +e
doctor_output=$("$DOCTOR_COMMAND" --target minimalist-v03 2>&1)
doctor_status=$?
set -e
printf '%s\n' "$doctor_output"
case "$doctor_status" in
    0) ;;
    1)
        if $APPLY && ! $ALLOW_DEGRADED; then
            die "doctor reported degraded; review it and use --allow-degraded only if its limits are acceptable"
        fi
        warn "doctor reported degraded compatibility"
        ;;
    2) die "doctor reported unsupported; Minimalist v0.3 apply is refused" ;;
    *) die "doctor could not produce a trustworthy result (exit $doctor_status)" ;;
esac

DBUS_TOOL=$(resolve_dbus_tool) \
    || die "required Plasma 6 D-Bus client not found (tried qdbus6, qdbus-qt6, qdbus)"
load_managed_paths "$MANIFEST"

declare -A managed=()
for relative in "${MANAGED_PATHS[@]}"; do
    managed[$relative]=1
done

layout_source="$REPO_ROOT/$LAYOUT_SOURCE_RELATIVE"
layout_destination="$TARGET_HOME/$LAYOUT_TARGET_RELATIVE"
resource_source="$REPO_ROOT/$RESOURCE_SOURCE_RELATIVE"
resource_destination="$TARGET_HOME/$RESOURCE_TARGET_RELATIVE"

for target_relative in "$LAYOUT_TARGET_RELATIVE" "$RESOURCE_TARGET_RELATIVE"; do
    validate_relative_path "$target_relative" || die "unsafe v0.3 target: $target_relative"
    [[ -n ${managed[$target_relative]+x} ]] || die "v0.3 target is not managed: $target_relative"
    assert_parent_within_home "$TARGET_HOME" "$target_relative"
done
[[ -d $layout_source && ! -L $layout_source ]] || die "v0.3 layout source is missing or unsafe"
[[ -d $resource_source && ! -L $resource_source ]] || die "resource Plasmoid source is missing or unsafe"
[[ -f $layout_source/metadata.json
    && -f $layout_source/contents/preflight.js
    && -f $layout_source/contents/layout.js
    && -f $layout_source/contents/postcheck.js ]] || die "v0.3 layout package is incomplete"
[[ -f $resource_source/metadata.json
    && -f $resource_source/contents/ui/main.qml ]] || die "resource Plasmoid package is incomplete"

evaluate_plasma_script() {
    "$DBUS_TOOL" org.kde.plasmashell /PlasmaShell \
        org.kde.PlasmaShell.evaluateScript "$1"
}

printf 'Minimalist v0.3 mode: %s\n' "$($APPLY && printf APPLY || printf 'DRY RUN')"
printf 'Target home: %s\n' "$TARGET_HOME"
printf '\n1. Current topology (read-only)\n'
preflight=$(evaluate_plasma_script "$(< "$layout_source/contents/preflight.js")")
printf '%s\n' "$preflight"
[[ $preflight == *MINIMALIST_V03_PREFLIGHT_OK* ]] \
    || die "live panel differs from the exact Minimalist v0.2/v0.3 states"
case "$preflight" in
    *topology=minimalist-v02*) current_topology=minimalist-v02 ;;
    *topology=minimalist-v03*) current_topology=minimalist-v03 ;;
    *) die "v0.3 preflight omitted its accepted topology" ;;
esac
case "$preflight" in
    *" height=28 "*) current_height=28 ;;
    *" height=32 "*) current_height=32 ;;
    *) die "v0.3 preflight omitted its accepted panel height" ;;
esac

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
apply_id="$timestamp-minimalist-v03-$$"
snapshot_path="$TARGET_HOME/.local/state/kde-rice/snapshots/$apply_id"
displaced_path="$TARGET_HOME/.local/state/kde-rice/apply-displaced/$apply_id"
snapshot_prepared=false
if $APPLY && [[ -n ${KDE_RICE_TRANSACTION_SNAPSHOT:-} \
    || -n ${KDE_RICE_TRANSACTION_RECEIPT:-} ]]; then
    capture_or_reuse_snapshot "$TARGET_HOME" "$snapshot_path" "$SCRIPT_DIR/snapshot" snapshot_path
    snapshot_prepared=true
fi
printf -v restore_preview '%q --backup %q --home %q' \
    "$SCRIPT_DIR/restore" "$snapshot_path" "$TARGET_HOME"
printf -v restore_apply '%s --apply' "$restore_preview"
assert_parent_within_home "$TARGET_HOME" ".local/state/kde-rice/snapshots/$apply_id"
assert_parent_within_home "$TARGET_HOME" ".local/state/kde-rice/apply-displaced/$apply_id"

printf '\n2. Complete change plan\n'
printf '  current accepted topology: %s on one screen-0 top panel\n' "$current_topology"
printf '  managed asset write: %s -> %s\n' "$RESOURCE_SOURCE_RELATIVE" "$RESOURCE_TARGET_RELATIVE"
printf '  managed asset write: %s -> %s\n' "$LAYOUT_SOURCE_RELATIVE" "$LAYOUT_TARGET_RELATIVE"
printf '  managed Plasma config that may change: .config/plasma-org.kde.plasma.desktop-appletsrc\n'
printf '  panel removals: none\n'
printf '  panel height: %s -> 32 logical px; preserve the existing panel instance\n' "$current_height"
if [[ $current_topology == minimalist-v02 ]]; then
    printf '  panel additions: one %s widget\n' 'org.kde.minimalist.resources'
else
    printf '  panel additions: none; preserve and reconfigure the existing %s widget\n' \
        'org.kde.minimalist.resources'
fi
printf '  target order: launcher | active title | spacer | CPU/RAM/GPU/VOL | margin | input | tray | time\n'
printf '  clock policy: date hidden; 24-hour time with seconds; automatic system font sizing\n'
printf '  sensors: cpu/all/usage, memory/physical/usedPercent, gpu/gpu0/usage with gpu/all/usage fallback\n'
printf '  GPU policy: prefer KDE sensor gpu/gpu0/usage; hide only the GPU label when neither sensor is available\n'
printf '  preserve: panel geometry other than height, existing widget instances and unrelated settings, wallpaper, KWin, and display configuration\n'
printf '  snapshot before first write: %s\n' "$snapshot_path"
printf '  rollback preview: %s\n' "$restore_preview"
printf '  rollback apply: %s\n' "$restore_apply"

if ! $APPLY; then
    printf '\nDry run only; no snapshot, package, widget, panel, or KDE setting was written.\n'
    exit 0
fi

printf '\n3. Capturing the complete managed scope before the first write\n'
if ! $snapshot_prepared; then
    capture_or_reuse_snapshot "$TARGET_HOME" "$snapshot_path" "$SCRIPT_DIR/snapshot" snapshot_path
else
    printf 'Bootstrap baseline was already validated before this component plan.\n'
fi

apply_error() {
    local status=$?
    warn "Minimalist v0.3 apply stopped after an error; Plasma and KWin were not restarted"
    warn "snapshot: $snapshot_path"
    warn "restore preview: $restore_preview"
    warn "restore apply: $restore_apply"
    exit "$status"
}
trap apply_error ERR

umask 077
install_package() {
    local source_path=$1
    local destination=$2
    local target_relative=$3
    local temporary="$destination.kde-rice-new-$$"
    local current

    current=$(path_type "$destination")
    [[ $current != unsupported ]] || die "managed target has an unsupported type: $target_relative"
    [[ ! -e $temporary && ! -L $temporary ]] || die "temporary install path already exists: $temporary"
    mkdir -p -- "$(dirname -- "$destination")"
    cp -a -- "$source_path" "$temporary"
    if [[ $current != absent ]]; then
        mkdir -p -- "$displaced_path/$(dirname -- "$target_relative")"
        mv -- "$destination" "$displaced_path/$target_relative"
    fi
    mv -- "$temporary" "$destination"
}

printf '\n4. Installing exact project packages\n'
install_package "$resource_source" "$resource_destination" "$RESOURCE_TARGET_RELATIVE"
install_package "$layout_source" "$layout_destination" "$LAYOUT_TARGET_RELATIVE"

printf '\n5. Adding or reconfiguring the resource widget\n'
result=$(evaluate_plasma_script "$(< "$layout_destination/contents/layout.js")")
printf '%s\n' "$result"
[[ $result == *MINIMALIST_V03_RESOURCE_STRIP_OK* ]] \
    || die "Plasma did not confirm the Minimalist v0.3 transition"

printf '\n6. Read-only post-apply verification\n'
post_result=
for attempt in {1..10}; do
    post_result=$(evaluate_plasma_script "$(< "$layout_destination/contents/postcheck.js")")
    [[ $post_result == *MINIMALIST_V03_POSTCHECK_OK* ]] && break
    ((attempt == 10)) || sleep 0.1
done
printf '%s\n' "$post_result"
[[ $post_result == *MINIMALIST_V03_POSTCHECK_OK* ]] \
    || die "live v0.3 topology or resource-widget revision did not match the target"

trap - ERR
printf '\nMinimalist v0.3 resource strip apply complete.\n'
printf 'Pre-apply snapshot: %s\n' "$snapshot_path"
printf 'Restore preview: %s\n' "$restore_preview"
printf 'Restore apply: %s\n' "$restore_apply"
if [[ -d $displaced_path ]]; then
    printf 'Replaced managed packages: %s\n' "$displaced_path"
fi
printf 'No panel, existing widget, wallpaper, KWin, or display setting was removed.\n'
if [[ $current_topology == minimalist-v03 ]]; then
    printf 'The exact package is installed; Plasma may retain the already-running applet QML until the next user sign-in.\n'
fi
