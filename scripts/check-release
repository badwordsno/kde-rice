#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
if (($#)); then
    printf 'Usage: scripts/check-release\nRuns isolated tests, syntax checks, two builds, and extracted-source tests.\n'
    [[ $# == 1 && ( $1 == --help || $1 == -h ) ]] && exit 0
    exit 64
fi
cd -- "$REPO_ROOT"
output=$(mktemp -d /tmp/kde-rice-release-check.XXXXXX)
visual_incomplete=false
printf 'Local release-check artifacts and logs: %s\n' "$output"
trap 'printf "Release check failed; inspect logs in %s\\n" "$output" >&2' ERR
check_tree() {
    local tree=$1
    local label=$2
    local test_script shell_file
    mkdir -p "$output/$label-logs"
    for test_script in "$tree"/tests/test-*.sh; do
        bash "$test_script" > "$output/$label-logs/${test_script##*/}.log" 2>&1
        printf 'PASS %s/%s\n' "$label" "${test_script##*/}"
    done
    for shell_file in "$tree"/scripts/* "$tree"/scripts/lib/*.sh "$tree"/tests/*.sh "$tree"/tests/lib/*.sh; do
        [[ -f $shell_file ]] || continue
        bash -n "$shell_file"
    done
    local visual_status=0
    local visual_log="$output/$label-logs/test-panel-readability.py.log"
    if command -v python3 >/dev/null 2>&1; then
        python3 "$tree/tests/test-panel-readability.py" > "$visual_log" 2>&1 || visual_status=$?
    else
        printf 'NOT RUN: python3 is unavailable\n' > "$visual_log"
        visual_status=77
    fi
    case "$visual_status" in
        0) printf 'PASS %s/test-panel-readability.py\n' "$label" ;;
        77)
            visual_incomplete=true
            printf 'NOT RUN %s/test-panel-readability.py (missing dependencies)\n' "$label"
            cat -- "$visual_log"
            ;;
        *)
            printf 'FAIL %s/test-panel-readability.py; inspect %s\n' "$label" "$visual_log" >&2
            return "$visual_status"
            ;;
    esac
}
check_tree "$REPO_ROOT" candidate
if [[ -d .git || -f .git ]]; then
    git diff --check
fi
for build in one two; do
    "$SCRIPT_DIR/build-release" --output "$output/$build" > "$output/build-$build.log" 2>&1
    (cd "$output/$build" && sha256sum --check SHA256SUMS)
done
cmp "$output/one/SHA256SUMS" "$output/two/SHA256SUMS"
mkdir "$output/extracted"
version=$(< "$REPO_ROOT/VERSION")
tar -xf "$output/one/minimalist-black-kde-$version.tar.xz" -C "$output/extracted"
check_tree "$output/extracted/minimalist-black-kde-$version" extracted
if $visual_incomplete; then
    printf 'INCOMPLETE: readability checks were not run; see dependency diagnostics above. Exit 77; no complete release pass.\n' >&2
    exit 77
fi
printf 'Automated release gate passed. Native acceptance is still required; nothing was published.\n'
